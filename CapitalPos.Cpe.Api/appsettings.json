{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DeploymentTopology": {
    "InternalOnly": true,
    "AllowedCaller": "capitalpos-api",
    "ExposePublicCors": false
  },
  "AllowedHosts": "*",
  "CpeSecuritySettings": {
    "ApiKeyEnabled": true,
    "HeaderName": "X-API-KEY",
    "ApiKey": "dev-local-cpe-key",
    "RutasPublicas": [
      "/api/health",
      "/swagger"
    ]
  }
}
